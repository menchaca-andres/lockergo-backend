generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum ComponentCategory {
  SENSOR
  ACTUATOR
  DISPLAY
}

enum ValueKind {
  NUMBER
  BOOLEAN
  STRING
  JSON
}

enum Quality {
  OK
  OUT_OF_RANGE
  ERROR
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

enum CommandStatus {
  PENDING
  SENT
  DONE
  FAILED
}

model User {
  id_user      Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments   LockerAssignment[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
}

model Locker {
  id_locker Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  assignments LockerAssignment[]
  devices     Device[]
  readings    Reading[]
  events      Event[]
}

model LockerAssignment {
  id_assignment Int       @id @default(autoincrement())
  userId        Int
  lockerId      Int
  startsAt      DateTime  @default(now())
  endsAt        DateTime?
  user          User      @relation(fields: [userId], references: [id_user], onDelete: Cascade)
  locker        Locker    @relation(fields: [lockerId], references: [id_locker], onDelete: Cascade)

  @@unique([userId, lockerId])
}

model Device {
  id_device       Int       @id @default(autoincrement())
  code            String    @unique
  lockerId        Int
  boardModel      String    @default("ESP32-38pin")
  apiKeyHash      String
  firmwareVersion String?
  configVersion   Int       @default(1)
  lastSeenAt      DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  locker     Locker      @relation(fields: [lockerId], references: [id_locker])
  components Component[]
}

model ComponentType {
  id_ct      Int               @id @default(autoincrement())
  code       String            @unique
  name       String
  category   ComponentCategory
  valueKind  ValueKind
  unit       String?
  eventRules Json?
  models     ComponentModel[]
}

model ComponentModel {
  id_cm         Int     @id @default(autoincrement())
  typeId        Int
  code          String  @unique
  name          String
  manufacturer  String?
  driver        String
  defaultConfig Json?
  isActive      Boolean @default(true)

  type       ComponentType @relation(fields: [typeId], references: [id_ct])
  components Component[]
}

model Component {
  id_component Int      @id @default(autoincrement())
  deviceId     Int
  modelId      Int
  key          String
  name         String
  config       Json
  calibration  Json?
  isEnabled    Boolean  @default(true)
  installedAt  DateTime @default(now())

  device   Device         @relation(fields: [deviceId], references: [id_device], onDelete: Cascade)
  model    ComponentModel @relation(fields: [modelId], references: [id_cm])
  readings Reading[]
  events   Event[]
  commands Command[]

  @@unique([deviceId, key])
}

model Reading {
  id_reading  BigInt   @id @default(autoincrement())
  componentId Int
  lockerId    Int
  valueNum    Float?
  valueBool   Boolean?
  valueText   String?
  payload     Json?
  quality     Quality  @default(OK)
  recordedAt  DateTime
  receivedAt  DateTime @default(now())

  component Component @relation(fields: [componentId], references: [id_component], onDelete: Cascade)
  locker    Locker    @relation(fields: [lockerId], references: [id_locker])
  events    Event[]

  @@index([componentId, recordedAt(sort: Desc)])
  @@index([lockerId, recordedAt(sort: Desc)])
}

model Event {
  id_event       BigInt    @id @default(autoincrement())
  lockerId       Int
  componentId    Int?
  readingId      BigInt?
  type           String
  severity       Severity  @default(INFO)
  detail         Json?
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  locker    Locker     @relation(fields: [lockerId], references: [id_locker])
  component Component? @relation(fields: [componentId], references: [id_component], onDelete: SetNull)
  reading   Reading?   @relation(fields: [readingId], references: [id_reading], onDelete: SetNull)

  @@index([lockerId, createdAt(sort: Desc)])
  @@index([type])
}

model Command {
  id_command  Int           @id @default(autoincrement())
  componentId Int
  action      String
  params      Json?
  status      CommandStatus @default(PENDING)
  requestedBy Int?
  createdAt   DateTime      @default(now())
  executedAt  DateTime?

  component Component @relation(fields: [componentId], references: [id_component], onDelete: Cascade)
}

model RefreshToken {
  id_rt     Int       @id @default(autoincrement())
  userId    Int
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id_user], onDelete: Cascade)
}

model AuditLog {
  id_al     Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id_user], onDelete: SetNull)
}
